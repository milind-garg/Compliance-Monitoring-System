# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=cms
POSTGRES_PASSWORD=cms_secret
POSTGRES_DB=cms

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=cms
RABBITMQ_PASSWORD=cms_secret
RABBITMQ_URL=amqp://cms:cms_secret@localhost:5672/

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cms-docs
MINIO_SECURE=false

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_in_production_use_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Service URLs (used by gateway / inter-service) ────────────────────────────
AUTH_SERVICE_URL=http://auth-service:8000
COMPLIANCE_SERVICE_URL=http://compliance-service:8000
INSPECTION_SERVICE_URL=http://inspection-service:8000
VIOLATION_SERVICE_URL=http://violation-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000
AI_ENGINE_URL=http://ai-engine:8000

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=amqp://cms:cms_secret@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/10

# ── Email (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@compliance.local

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
